{
  "name": "tracetriage-presentation",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion presentation film for TraceTriage. Every number on screen is read at build time from a receipt in this repository.",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Film out/tracetriage-film.mp4 --concurrency=4 --muted --pixel-format=yuv420p",
    "poster": "remotion still Film out/tracetriage-film-poster.jpg --frame=1730 --jpeg-quality=92",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@remotion/cli": "4.0.489",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.489"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.2",
    "vitest": "3.2.4"
  }
}
