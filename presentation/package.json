{
  "name": "tracetriage-presentation",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion presentation film for TraceTriage. Every number on screen is read at build time from a receipt in this repository.",
  "scripts": {
    "studio": "remotion studio",
    "workspace": "python ../scripts/film_workspace.py",
    "render": "remotion render Film ../../film-local/out/tracetriage-film.mp4 --concurrency=4 --pixel-format=yuv420p --crf=18",
    "film-poster": "remotion still Film ../../film-local/out/tracetriage-film-poster.jpg --frame=1730 --jpeg-quality=94",
    "poster": "remotion still Poster ../../film-local/out/tracetriage-thumbnail.jpg --jpeg-quality=94 --scale=2",
    "test": "vitest run",
    "report": "vite-node scripts/report-table.ts",
    "narration": "vite-node scripts/build-narration.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@remotion/cli": "4.0.489",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.489"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.2",
    "vite-node": "3.2.4",
    "vitest": "3.2.4"
  }
}
