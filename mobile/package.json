{
  "name": "tracetriage-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Android client for TraceTriage. Three screens over the same measurements the console shows and the same endpoint it measures with.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "apk": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "expo": "^57.0.15",
    "expo-constants": "~57.0.13",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~5.9.2"
  }
}
