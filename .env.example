# TraceTriage environment template. Copy to .env and fill in. Never commit .env.
#
# TraceTriage holds NO write credential of any kind, by design.
# There is no SatNOGS API key here and there must never be one.
# The public read-only API needs no authentication (verified, see docs/SATNOGS_API_RECON.md).

# Contact address sent in the User-Agent header when reading the public SatNOGS API.
# Courtesy to the volunteers running the network. Keep it real.
TRACETRIAGE_CONTACT_EMAIL=kesavk659@gmail.com
TRACETRIAGE_USER_AGENT=TraceTriage/0.1 (+https://github.com/Kesav2k04/TraceTriage; kesavk659@gmail.com)

# Seconds between paged API requests. Do not lower below 0.4 without a reason.
TRACETRIAGE_REQUEST_DELAY=0.4

# Snapshot root. Keep on D:, never C:.
TRACETRIAGE_DATA_DIR=D:/IBM August Challenge/TraceTriage/data

# Optional local Granite endpoint for typed queue-filter parsing.
# Leave blank to disable. The typed form is the primary control and must always work.
TRACETRIAGE_GRANITE_URL=
