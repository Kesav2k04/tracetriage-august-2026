# TraceTriage environment template. Copy to .env and fill in what you need.
# Never commit .env.
#
# Every variable here is read by tracked Python in this repository, and each one says
# which file reads it. The previous version of this template documented five that nothing
# reads: TRACETRIAGE_CONTACT_EMAIL, TRACETRIAGE_USER_AGENT, TRACETRIAGE_REQUEST_DELAY,
# TRACETRIAGE_DATA_DIR and TRACETRIAGE_GRANITE_URL. Two of those were the worst kind of
# wrong, because they looked configurable and were not: the User-Agent and the request
# interval are constants in pipeline/tracetriage/snapshot.py, so a reuser who set their
# own contact address here still sent the author's to the volunteers running SatNOGS,
# under a comment that said "keep it real". It also omitted the one variable the pipeline
# refuses to run without.
#
# TraceTriage holds NO write credential of any kind, by design. There is no SatNOGS API
# key here and there must never be one: the public read-only API needs no authentication
# (verified, see docs/SATNOGS_API_RECON.md).

# ---------------------------------------------------------------------------
# The snapshot. Anything that rebuilds a split, an artifact or an evidence card
# needs this; nothing that reads a committed receipt does.
# ---------------------------------------------------------------------------

# The pages folder inside the snapshot root, as an absolute path.
# pipeline/tracetriage/splits.py refuses by name when this is unset rather than guessing a
# path, because the snapshot is 20 GB and lives outside the repository on purpose, and a
# guess resolves to a directory that does not exist and reads as an empty snapshot.
TRACETRIAGE_PAGES_DIR=

# A snapshot directory for the three test modules that measure against real data:
# tests/test_base_rates.py, tests/test_glyph_axis.py and tests/test_live.py. Unset, those
# tests skip and print the reason, which is how the offline gate stays hermetic.
TRACETRIAGE_SNAPSHOT=

# ---------------------------------------------------------------------------
# Optional model backends. Nothing this project publishes needs any of them.
# ---------------------------------------------------------------------------

# watsonx.ai text generation, read by pipeline/tracetriage/watsonx.py. The first two are
# required and the third has a default. Left blank, scripts/run_watsonx_check.py records a
# dated NOT_CHECKED outcome rather than a pass: no number here comes from an IBM Cloud
# account, and the grounding checker judges a hosted draft by the same rules as a local
# one.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=

# Where the local model runtime answers, read by scripts/run_langflow_check.py. Defaults
# to http://127.0.0.1:11434, which is Ollama's own address.
TRACETRIAGE_OLLAMA_URL=

# A Python interpreter that has LangFlow installed, read by scripts/run_langflow_check.py.
# LangFlow is deliberately not a dependency of this project, so the flow check runs out of
# a separate environment or refuses to run at all.
TRACETRIAGE_LANGFLOW_PYTHON=

# ---------------------------------------------------------------------------
# Model weights that are not committed
# ---------------------------------------------------------------------------

# The folder holding the Kokoro 82M voice files, read by scripts/render_narration.py. They
# are 354 MB and that script names the two commands that fetch them.
TRACETRIAGE_KOKORO_DIR=

# Where easyocr keeps its downloaded model, read by pipeline/tracetriage/waterfall.py.
# The OCR path is optional: pipeline/tracetriage/glyph_axis.py reads the same axis labels
# with nothing beyond numpy and pillow.
EASYOCR_MODULE_PATH=

# ---------------------------------------------------------------------------
# The two investigation scripts, which cache their own fetches
# ---------------------------------------------------------------------------
#
# scripts/a3_doppler_investigation.py reads A3_CACHE_DIR and A3_TARGET_OBS.
# scripts/validate_physics.py reads A3_CACHE_DIR, A4_OUT_PATH, A4_END_DATE,
# A4_TARGET_OBS and A4_MAX_PAGES. Every one has a default, so a plain run needs none of
# them. They are named here rather than assigned because a reader who wants them wants to
# move a cache or narrow a window, and a blank line in a template would not say which.

# ---------------------------------------------------------------------------
# Read by this repository and not for a .env
# ---------------------------------------------------------------------------
#
# TRACETRIAGE_SIGNOFF_IN_PROGRESS is set by scripts/signoff.py for the gate run it spawns
# and read by scripts/gate.py. CLEAN_CLONE_HIDE_SNAPSHOT is a test hook in
# scripts/clean_clone_check.py. UV_CACHE_DIR is recorded by that same script for
# provenance. Setting any of them by hand changes what a check measures, so they are
# listed for completeness and left out of the assignments above.
