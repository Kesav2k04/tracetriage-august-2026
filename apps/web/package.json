{
  "name": "tracetriage-console",
  "version": "0.1.0",
  "private": true,
  "description": "Static evidence console for TraceTriage. No server, no database, no cloud inference, no credentials: everything it shows was measured offline and validated against a contract before it reached disk.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "15.5.23",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "typescript": "5.7.2",
    "vitest": "^3.2.7"
  }
}
