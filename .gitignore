# --- environment ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
node_modules/
.next/
dist/
build/

# --- data plane: never commit the snapshot or the artifacts it derives ---
data/
!data/.gitkeep
*.parquet
*.npy
*.npz
*.pt
*.pth
*.onnx
*.png
!docs/**/*.png
!tests/fixtures/**/*.png
!apps/web/public/**/*.png

# --- generated artifacts: manifests are committed, payloads are not ---
artifacts/**/*
# Directories must be re-included first. Git does not descend into an
# excluded directory, so without this every negation below is dead and
# the evidence silently never stages.
!artifacts/**/
!artifacts/.gitkeep
!artifacts/**/*.json
!artifacts/**/*.md
!artifacts/a3_overlays/*.png

# --- secrets ---
.env
.env.local
*.key
*.pem
credentials*.json

# --- os / editor ---
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# working brief, not part of the judged submission
BOB_START_HERE.md

# --- A3 investigation cache: API pages and waterfall PNGs, not evidence ---
.a3_cache/
