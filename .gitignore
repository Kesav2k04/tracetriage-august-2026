# --- environment ---
.venv/
# LangFlow lives in its own environment on purpose: it resolves several hundred
# packages and pins against versions the measurement path is fixed to. Nothing this
# repository publishes depends on it. scripts/run_langflow_check.py names the two
# commands that create this directory when it is absent.
.venv-langflow/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
node_modules/
.next/
dist/
build/

# --- data plane: never commit the snapshot or the artifacts it derives ---
# Root-anchored. An unanchored `data/` also matched apps/web/public/data, which
# is the console's committed build input, so the deploy silently had no numbers.
/data/
!/data/.gitkeep
*.parquet
*.npy
*.npz
*.pt
*.pth
*.onnx
*.png
!docs/**/*.png
!tests/fixtures/**/*.png
!apps/web/public/**/*.png
# The Android client's launcher icon, generated from the same mark by
# scripts/build_pwa_icons.py. Expo reads it at build time, so a clone that does not have it
# builds an app with the default Expo icon and nothing says so.
!mobile/assets/*.png

# --- generated artifacts: manifests are committed, payloads are not ---
artifacts/**/*
# Directories must be re-included first. Git does not descend into an
# excluded directory, so without this every negation below is dead and
# the evidence silently never stages.
!artifacts/**/
!artifacts/.gitkeep
!artifacts/**/*.json
!artifacts/**/*.md
!artifacts/a3_overlays/*.png

# The two explainer-clip receipts, back out again. They are production detail: the
# spoken script for the console's two video explainers, line by line, and the record of
# what a second model heard when it transcribed the rendered audio back. A judge has
# minutes, and a narration script is not what they are for. The narration receipt also
# names the digest of a private voice recording, which stays unpublished for its own
# reason. Written after the `.json` re-include above and it wins because it comes last.
# What the site serves is untouched: the two .mp4 clips, their posters and their .vtt
# captions under apps/web/public/media are committed and must stay that way.
artifacts/EXPLAINER_NARRATION.json
artifacts/EXPLAINER_CLIPS.json

# Reviewer annotations are private local notes and are never committed. They are
# already excluded by the catch-all above, but only incidentally, and a future
# re-include written for some other .jsonl would start committing them silently.
# This says so on purpose, and it wins because it comes last.
artifacts/annotations/
*.jsonl

# --- secrets ---
.env
.env.local
*.key
*.pem
credentials*.json

# --- os / editor ---
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# --- A3 investigation cache: API pages and waterfall PNGs, not evidence ---
.a3_cache/

# --- console build output ---
# apps/web/out is what `next build` writes: it is the deploy artifact, derived
# entirely from public/ and the receipts, and committing it would put a second
# copy of every waterfall in the history. The imagery under public/ is committed
# because the console cannot be rebuilt without it; the export is not.
apps/web/out/
apps/web/tsconfig.tsbuildinfo
.playwright-mcp/

# Manim render scratch. The scene source is committed and the finished video is
# committed to apps/web/public/media, which is what the site serves. The render tree
# holds partial movie files, per-text SVG caches and converted font binaries, all of
# which are reproducible from scripts/explainer_corridor.py and none of which a
# reviewer needs.
/media/

# The gate 3 pool build appends finished records here so a run that dies can resume.
# The assembled receipt beside it is what gets committed.
artifacts/*.partial.jsonl
